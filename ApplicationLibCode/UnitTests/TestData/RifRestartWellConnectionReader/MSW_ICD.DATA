-- A horizontal multi-segment well with two ICD valves, for the restart well connection reader tests
RUNSPEC
DIMENS
 5 1 2 /
OIL
WATER
METRIC
WELLDIMS
 1 10 1 1 /
WSEGDIMS
 1 20 10 /
UNIFOUT
GRID
INIT
DX
 10*100 /
DY
 10*100 /
DZ
 10*5 /
TOPS
 5*2000 /
PORO
 10*0.25 /
PERMX
 10*500 /
PERMY
 10*500 /
PERMZ
 10*50 /
PROPS
PVDO
 100 1.2 1.0
 300 1.15 1.1 /
PVTW
 200 1.0 4.5E-5 0.5 0 /
DENSITY
 850 1000 1 /
ROCK
 200 4E-5 /
SWOF
 0.2 0 1 0
 0.8 1 0 0 /
SOLUTION
EQUIL
 2000 200 2100 0 1500 0 /
SCHEDULE
RPTRST
 BASIC=2 /
WELSPECS
 'P1' 'G' 1 1 2002.5 OIL /
/
COMPDAT
 'P1' 2 1 1 1 OPEN 1* 1* 0.2 1* 0 1* 'X' /
 'P1' 3 1 1 1 OPEN 1* 1* 0.2 1* 0 1* 'X' /
 'P1' 4 1 1 1 OPEN 1* 1* 0.2 1* 0 1* 'X' /
/
WELSEGS
 'P1' 2002.5 2050.0 1* ABS 'HF-' /
 2 2 1 1 2150.0 2002.0 0.15 0.0001 /
 3 3 1 2 2250.0 2002.5 0.15 0.0001 /
 4 4 1 3 2350.0 2002.5 0.15 0.0001 /
 5 5 2 3 2250.1 2002.5 0.15 0.0001 /
 6 6 3 4 2350.1 2002.5 0.15 0.0001 /
/
COMPSEGS
 'P1' /
 2 1 1 1 2100.0 2200.0 /
 3 1 1 2 2200.0 2300.0 1* 1* 1* 1* 5 /
 4 1 1 3 2300.0 2400.0 1* 1* 1* 1* 6 /
/
WSEGVALV
 'P1' 5 0.7 2.0E-4 /
 'P1' 6 0.8 3.0E-4 /
/
WCONPROD
 'P1' OPEN BHP 5* 150 /
/
TSTEP
 1 /
END
